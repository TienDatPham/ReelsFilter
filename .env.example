# Ollama model to use for classification (must be pulled: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2

# Path to Google Service Account JSON key file
GOOGLE_SA_JSON=service_account.json

# Google Spreadsheet ID (from the URL: docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab to write to (default: Reels)
SHEET_NAME=Reels
